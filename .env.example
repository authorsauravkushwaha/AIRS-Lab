# AEGIS AI LAB — copy to .env and fill in. Never commit .env.
AEGIS_DATABASE_URL=sqlite:///./aegis.db

# Server-side only. The API key value is never stored in the DB or sent to the frontend.
AEGIS_OPENAI_API_KEY=
AEGIS_ANTHROPIC_API_KEY=
AEGIS_OLLAMA_BASE_URL=http://localhost:11434

# Server-side DLP scrubber applied to production traces before persistence.
AEGIS_SECRET_REDACTION_ENABLED=true

# CORS allowlist (comma-separated origins). Default "*" is acceptable because the
# server binds to 127.0.0.1 by default; set an explicit list when exposing the
# service beyond localhost.
# AEGIS_CORS_ORIGINS=https://lab.example.com

# Optional: where generated reports are written (default: backend/reports_out).
# AEGIS_REPORT_DIR=./reports_out
